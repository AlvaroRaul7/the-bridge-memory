# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Chroma Cloud (https://www.trychroma.com/) — used by memory_engine/
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=intelligent-memory

# Anthropic API — used by create_agent.py / run_session_*.py / the agent itself
ANTHROPIC_API_KEY=

# --- backend/ ---------------------------------------------------------------

# The X-API-Key callers must send. The service refuses to start without one, so
# it is never accidentally exposed unauthenticated.
#     openssl rand -hex 16
BACKEND_API_KEY=

# Managed Agents resource IDs for the /session tier. create_agent_v2.py writes
# them to .agent_id_v2 / .environment_id_v2 / .memory_store_id_v2; setting them
# here points the backend at the v2 agent instead of create_agent.py's dotfiles.
# Ask the team for the shared values rather than provisioning your own.
AGENT_ID=
ENVIRONMENT_ID=
MEMORY_STORE_ID=

# Spec 3's dev origin, comma-separated. The frontend's origin, not the backend's.
CORS_ORIGINS=http://localhost:5173

# Wall-clock ceiling on one agent turn. A cold first turn is slow.
AGENT_TIMEOUT_SECONDS=300
