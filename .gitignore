# Managed Agents resource IDs — provisioned once, committed deliberately, not by accident
.agent_id
.environment_id
.memory_store_id
.curator_agent_id
.deployment_id
.customer_memory_stores.json

# Spec 4 (v2 agent) — platform resource IDs
.agent_id_v2
.environment_id_v2
.memory_store_id_v2

# Secrets
.env
.env.*
!.env.example

# Local Chroma fallback store (memory_engine uses Chroma Cloud when
# CHROMA_API_KEY is set, and a PersistentClient under CHROMA_LOCAL_PATH
# otherwise — which defaults to ".chroma" relative to the working directory)
.chroma/
**/.chroma/

# Session output
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Tests
.pytest_cache/
