# Managed Agents resource IDs — provisioned once, committed deliberately, not by accident
.agent_id
.environment_id
.memory_store_id
.curator_agent_id
.deployment_id

# Spec 4 (v2 agent) — platform resource IDs
.agent_id_v2
.environment_id_v2
.memory_store_id_v2

# Secrets
# `.env*` (not `.env.*`) so variants like `.env_backend` and `.env-local` are
# covered too — the dotted pattern alone missed them, and one such file was
# holding live API keys.
.env*
!.env.example

# Session output
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Tests
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/screenshots/
frontend/test-results/
frontend/playwright-report/

# Per-scenario provisioning state
.state/

# macOS
.DS_Store
