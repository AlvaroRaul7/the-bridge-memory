# Spec 2 FastAPI backend. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Single dev API key for the workshop, sent as X-API-Key on every request.
# Spec 2 out-of-scope note: per-tenant keys are the upgrade path.
VITE_API_KEY=dev-key

# "true" runs the msw mock backend in the browser instead of calling the API.
# This is the one-line switch Spec 3 asks for — flip to false when Spec 2 is up.
VITE_USE_MOCKS=true

# Clerk. LEAVE BLANK to run unauthenticated with the single dev API key above —
# that is the mode specs/03 describes and the mode the e2e suite runs in.
# Set it and the app gates behind sign-in, scopes memory to the signed-in
# account, and sends the Clerk session token as a Bearer header alongside
# X-API-Key. Get the key from the Clerk dashboard (starts with pk_test_).
VITE_CLERK_PUBLISHABLE_KEY=
